PORT=4000
JWT_SECRET=change-this-to-something-random

# Optional: real SMTP for OTP emails. If left blank, the app auto-creates a
# free Ethereal test inbox and still sends a real email (with a preview link
# returned in the API response) — no setup needed for a demo.
# Example with Gmail: create an "App Password" at myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockSense <no-reply@stocksense.local>"
